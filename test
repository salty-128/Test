local function parentGui()
	if typeof(gethui) == "function" then
		local ok, r = pcall(gethui)
		if ok and typeof(r) == "Instance" then return r end
	end
	return CoreGui
end

local function ui(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end

local function rounded(o, r) ui("UICorner", { CornerRadius = UDim.new(0, r) }, o) end

local function monoGradient(o, animated)
	local edge = Color3.fromRGB(130,130,135)
	local g = ui("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, edge),
			ColorSequenceKeypoint.new(.5, Color3.new(1,1,1)),
			ColorSequenceKeypoint.new(1, edge)
		}),
		Rotation = 45
	}, o)
	if animated then
		task.spawn(function()
			while g.Parent do
				local t = TweenService:Create(g, TweenInfo.new(6, Enum.EasingStyle.Linear), { Rotation = g.Rotation + 360 })
				t:Play(); t.Completed:Wait()
			end
		end)
	end
	return g
end

local function monoRing(o, animated)
	local ring = ui("UIStroke", {
		Color = Color3.new(1,1,1), Thickness = 2.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	}, o)
	local g = ui("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(90,90,95)),
			ColorSequenceKeypoint.new(.5, Color3.new(1,1,1)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(90,90,95)),
		})
	}, ring)
	if animated then
		task.spawn(function()
			while g.Parent do
				g.Rotation = 0
				local t = TweenService:Create(g, TweenInfo.new(3, Enum.EasingStyle.Linear), { Rotation = 360 })
				t:Play(); t.Completed:Wait()
			end
		end)
	end
	return ring
end

local function copyToClipboard(text)
	local target = text
	pcall(function()
		local setter = setclipboard
		if type(setter) == "function" then setter(target); return end
		local cb = game:GetService("Clipboard")
		if cb and type(cb.SetText) == "function" then cb:SetText(target) end
	end)
end

local function buildDiscordLink()
	local out = {}
	for i = 1, #DISCORD_PARTS do out[i] = DISCORD_PARTS[i] end
	return table.concat(out)
end

