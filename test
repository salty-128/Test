function Tab:Colorpicker(props)
    local el = { _type = "Colorpicker", _props = props, Value = props.Default or Color3.new(1,1,1), _callbacks = {} }
    if props.Flag then Registry[props.Flag] = el end
    function el:_fire() for _, c in ipairs(self._callbacks) do pcall(c, self.Value) end end
    function el:OnChanged(fn) table.insert(self._callbacks, fn); return self end
    function el:Set(v, silent)
        self.Value = v
        if self._update then self._update() end
        if not silent then self:_fire() end
    end
    function el:Get() return self.Value end
    function el:_render(parent)
        local row = ui("Frame", {
            Size = UDim2.new(1,0,0,88), BackgroundColor3 = COL.Card,
            BorderSizePixel = 0, ZIndex = 3,
        }, parent)
        rounded(row, 10)
        ui("UIStroke", { Color = Color3.new(1,1,1), Thickness = 1.5, Transparency = 0.55,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, row)
        ui("TextLabel", {
            Position = UDim2.fromOffset(14,6), Size = UDim2.new(1,-56,0,14),
            BackgroundTransparency = 1, Text = props.Title or "Color",
            TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
        }, row)
        local swatch = ui("Frame", {
            AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,6),
            Size = UDim2.fromOffset(28,14), BackgroundColor3 = el.Value,
            BorderSizePixel = 0, ZIndex = 4,
        }, row)
        rounded(swatch, 4)
        local keys = { "R", "G", "B" }
        local sliders = {}
        for i = 1, 3 do
            local y = 28 + (i-1) * 18
            ui("TextLabel", {
                Position = UDim2.fromOffset(14, y), Size = UDim2.fromOffset(12,14),
                BackgroundTransparency = 1, Text = keys[i],
                TextColor3 = Color3.fromRGB(180,180,185), Font = FONT.Button, TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
            }, row)
            local track = ui("Frame", {
                Position = UDim2.fromOffset(30, y + 5), Size = UDim2.new(1,-80,0,4),
                BackgroundColor3 = Color3.fromRGB(40,40,45), BorderSizePixel = 0, ZIndex = 4,
            }, row)
            rounded(track, 2)
            local fill = ui("Frame", {
                Size = UDim2.new(el.Value[keys[i]], 0, 1, 0),
                BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 5,
            }, track)
            rounded(fill, 2)
            sliders[i] = { track = track, fill = fill, key = keys[i] }
        end
        local function update()
            for i = 1, 3 do
                local s = sliders[i]
                s.fill.Size = UDim2.new(el.Value[s.key], 0, 1, 0)
            end
            swatch.BackgroundColor3 = el.Value
        end
        el._update = update
        update()
        for i = 1, 3 do
            local s = sliders[i]
            local dragging = false
            local function setFromInput(input)
                local pos = input.Position.X - s.track.AbsolutePosition.X
                local a = math.clamp(pos / math.max(s.track.AbsoluteSize.X, 1), 0, 1)
                local c = el.Value
                if s.key == "R" then c = Color3.new(a, c.G, c.B)
                elseif s.key == "G" then c = Color3.new(c.R, a, c.B)
                else c = Color3.new(c.R, c.G, a) end
                el.Value = c
                update()
                el:_fire()
            end
            s.track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; setFromInput(input)
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    setFromInput(input)
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end
    end
    table.insert(self.Elements, el)
    return el
end

function Tab:Keybind(props)
    local el = { _type = "Keybind", _props = props, Value = props.Value or "Unknown", _callbacks = {} }
    if props.Flag then Registry[props.Flag] = el end
    function el:_fire() for _, c in ipairs(self._callbacks) do pcall(c, self.Value) end end
    function el:OnChanged(fn) table.insert(self._callbacks, fn); return self end
    function el:Set(v, silent)
        self.Value = v
        if self._update then self._update() end
        if not silent then self:_fire() end
    end
    function el:Get() return self.Value end
    function el:_render(parent)
        local row = ui("TextButton", {
            Size = UDim2.new(1,0,0,38), BackgroundColor3 = COL.Card,
            Text = "", BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 3,
        }, parent)
        rounded(row, 10)
        ui("UIStroke", { Color = Color3.new(1,1,1), Thickness = 1.5, Transparency = 0.55,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, row)
        ui("TextLabel", {
            Position = UDim2.fromOffset(14,0), Size = UDim2.new(1,-80,1,0),
            BackgroundTransparency = 1, Text = props.Title or "Keybind",
            TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
        }, row)
        local keyLbl = ui("TextLabel", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0),
            Size = UDim2.fromOffset(60,20), BackgroundColor3 = Color3.fromRGB(20,20,24),
            Text = tostring(el.Value), TextColor3 = Color3.new(1,1,1),
            Font = FONT.Button, TextSize = 10, BorderSizePixel = 0, ZIndex = 4,
        }, row)
        rounded(keyLbl, 6)
        local listening = false
        local function update() keyLbl.Text = listening and "..." or tostring(el.Value) end
        el._update = update
        row.MouseButton1Click:Connect(function()
            listening = true
            update()
            local conn
            conn = UIS.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    el.Value = input.KeyCode.Name
                    listening = false
                    conn:Disconnect()
                    update()
                    el:_fire()
                end
            end)
        end)
    end
    table.insert(self.Elements, el)
    return el
end

