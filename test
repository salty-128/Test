function Window:SelectTab(tab)
	self.ActiveTab = tab
	for _, el in ipairs(self.ButtonFrame:GetChildren()) do
		if el:IsA("GuiObject") then el:Destroy() end
	end
	for _, el in ipairs(tab.Elements) do
		el:_render(self.ButtonFrame)
	end
	for _, t in ipairs(self.Tabs) do
		if t._row then
			local on = t == tab
			t._ring.Thickness = on and 2.2 or 1.5
			t._ring.Transparency = on and 0 or 0.55
			t._grad.Color = on and ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
				ColorSequenceKeypoint.new(.5, Color3.fromRGB(150,150,156)),
				ColorSequenceKeypoint.new(1, Color3.new(1,1,1)),
			}) or ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(90,90,95)),
				ColorSequenceKeypoint.new(.5, Color3.new(1,1,1)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(90,90,95)),
			})
		end
	end
end

