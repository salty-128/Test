function Tab:Slider(props)
	local el = { _type = "Slider", _props = props }
	local range = props.Range or { Min = 0, Max = 100, Default = 50 }
	el.Value = range.Default or range.Min
	function el:_render(parent)
		local row = ui("Frame", {
			Size = UDim2.new(1,0,0,54), BackgroundColor3 = COL.Card,
			BorderSizePixel = 0, ZIndex = 3,
		}, parent)
		rounded(row, 12)
		ui("UIStroke", {
			Color = Color3.new(1,1,1), Thickness = 1.8, Transparency = 0.55,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		}, row)

		ui("TextLabel", {
			Position = UDim2.fromOffset(16,6), Size = UDim2.new(1,-80,0,14),
			BackgroundTransparency = 1, Text = props.Title or "Slider",
			TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
		}, row)

		local valLbl = ui("TextLabel", {
			Position = UDim2.new(1,-64,0,6), Size = UDim2.fromOffset(50,14),
			BackgroundTransparency = 1, Text = tostring(el.Value),
			TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4,
		}, row)

		local track = ui("Frame", {
			Position = UDim2.fromOffset(16,36), Size = UDim2.new(1,-32,0,4),
			BackgroundColor3 = Color3.fromRGB(40,40,45), BorderSizePixel = 0, ZIndex = 4,
		}, row)
		rounded(track, 2)
		local fill = ui("Frame", {
			Size = UDim2.new(0,0,1,0), BackgroundColor3 = Color3.new(1,1,1),
			BorderSizePixel = 0, ZIndex = 5,
		}, track)
		rounded(fill, 2)

		local function refresh()
			local alpha = (el.Value - range.Min) / math.max(range.Max - range.Min, 1e-6)
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			valLbl.Text = tostring(math.floor(el.Value + 0.5))
		end
		refresh()

		local dragging = false
		local function update(input)
			local pos = input.Position.X - track.AbsolutePosition.X
			local alpha = math.clamp(pos / track.AbsoluteSize.X, 0, 1)
			el.Value = range.Min + (range.Max - range.Min) * alpha
			refresh()
			if props.Callback then pcall(props.Callback, el.Value) end
		end
		track.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = true; update(i)
			end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				update(i)
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end
	table.insert(self.Elements, el)
	return el
end

function Tab:Dropdown(props)
	local el = { _type = "Dropdown", _props = props }
	el.Values = props.Values or {}
	el.Value = props.Value
	function el:_render(parent)
		local row = ui("TextButton", {
			Size = UDim2.new(1,0,0,42), BackgroundColor3 = COL.Card,
			Text = "", BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 3,
		}, parent)
		rounded(row, 12)
		ui("UIStroke", {
			Color = Color3.new(1,1,1), Thickness = 1.8, Transparency = 0.55,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		}, row)
		local lbl = ui("TextLabel", {
			Position = UDim2.fromOffset(16,0), Size = UDim2.new(1,-40,1,0),
			BackgroundTransparency = 1,
			Text = props.Title or "Dropdown",
			TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
		}, row)
		monoGradient(lbl, true)

		local cur = ui("TextLabel", {
			Position = UDim2.fromOffset(16,20), Size = UDim2.new(1,-40,1,0),
			BackgroundTransparency = 1, Text = tostring(el.Value or "-"),
			TextColor3 = Color3.fromRGB(180,180,185), Font = FONT.Button, TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
		}, row)

		row.MouseButton1Click:Connect(function()
			if #el.Values == 0 then return end
			local idx = 1
			for i, v in ipairs(el.Values) do
				if v == el.Value then idx = i; break end
			end
			idx = idx % #el.Values + 1
			el.Value = el.Values[idx]
			cur.Text = tostring(el.Value)
			if props.Callback then pcall(props.Callback, el.Value) end
		end)
	end
	table.insert(self.Elements, el)
	return el
end

function FlowHub:CreateWindow(cfg)
	local win = Window:_init(cfg)
	win:AddTab("Main")
	win:SelectTab(win.Tabs[1])
	return win
end

return FlowHub
