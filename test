local function parentGui()
    if typeof(gethui) == "function" then
        local ok, r = pcall(gethui)
        if ok and typeof(r) == "Instance" then return r end
    end
    return CoreGui
end

local function ui(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end

local function rounded(o, r) ui("UICorner", { CornerRadius = UDim.new(0, r) }, o) end

local function monoGrad(o)
    return ui("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(130,130,135)),
            ColorSequenceKeypoint.new(.5, Color3.new(1,1,1)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(130,130,135))
        }),
        Rotation = 45
    }, o)
end

local function copyCB(text)
    pcall(function()
        if setclipboard then setclipboard(text); return end
        local cb = game:GetService("Clipboard")
        if cb and cb.SetText then cb:SetText(text) end
    end)
end

local function discordLink()
    local t = {}
    for i = 1, #DISCORD_PARTS do t[i] = DISCORD_PARTS[i] end
    return table.concat(t)
end

