function Tab:Slider(props)
    local range = props.Range or { Min = 0, Max = 100, Default = 50 }
    local el = { _type = "Slider", _props = props, Value = range.Default or range.Min, _callbacks = {} }
    if props.Flag then Registry[props.Flag] = el end
    function el:_fire() for _, c in ipairs(self._callbacks) do pcall(c, self.Value) end end
    function el:OnChanged(fn) table.insert(self._callbacks, fn); return self end
    function el:Set(v, silent)
        self.Value = math.clamp(v, range.Min, range.Max)
        if self._update then self._update() end
        if not silent then self:_fire() end
    end
    function el:Get() return self.Value end
    function el:_render(parent)
        local row = ui("Frame", {
            Size = UDim2.new(1,0,0,48), BackgroundColor3 = COL.Card,
            BorderSizePixel = 0, ZIndex = 3,
        }, parent)
        rounded(row, 10)
        ui("UIStroke", { Color = Color3.new(1,1,1), Thickness = 1.5, Transparency = 0.55,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, row)
        ui("TextLabel", {
            Position = UDim2.fromOffset(14,6), Size = UDim2.new(1,-80,0,14),
            BackgroundTransparency = 1, Text = props.Title or "Slider",
            TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
        }, row)
        local valLbl = ui("TextLabel", {
            Position = UDim2.new(1,-64,0,6), Size = UDim2.fromOffset(50,14),
            BackgroundTransparency = 1, Text = tostring(math.floor(el.Value)),
            TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4,
        }, row)
        local track = ui("Frame", {
            Position = UDim2.fromOffset(14,32), Size = UDim2.new(1,-28,0,4),
            BackgroundColor3 = Color3.fromRGB(40,40,45), BorderSizePixel = 0, ZIndex = 4,
        }, row)
        rounded(track, 2)
        local fill = ui("Frame", {
            Size = UDim2.new(0,0,1,0), BackgroundColor3 = Color3.new(1,1,1),
            BorderSizePixel = 0, ZIndex = 5,
        }, track)
        rounded(fill, 2)
        local function update()
            local a = (el.Value - range.Min) / math.max(range.Max - range.Min, 1e-6)
            fill.Size = UDim2.new(a, 0, 1, 0)
            valLbl.Text = tostring(math.floor(el.Value + 0.5))
        end
        el._update = update
        update()
        local dragging = false
        local function setFromInput(input)
            local pos = input.Position.X - track.AbsolutePosition.X
            local a = math.clamp(pos / math.max(track.AbsoluteSize.X, 1), 0, 1)
            el.Value = range.Min + (range.Max - range.Min) * a
            update()
            el:_fire()
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true; setFromInput(i)
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                setFromInput(i)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end
    table.insert(self.Elements, el)
    return el
end

