            Position = UDim2.fromOffset(14,0), Size = UDim2.new(1,-64,1,0),
            BackgroundTransparency = 1, Text = props.Title or "Toggle",
            TextColor3 = Color3.new(1,1,1), Font = FONT.Button, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
        }, row)
        monoGrad(lbl)
        local ind = ui("Frame", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0),
            Size = UDim2.fromOffset(28,15), BackgroundColor3 = Color3.fromRGB(40,40,45),
            BorderSizePixel = 0, ZIndex = 4,
        }, row)
        rounded(ind, 8)
        local knob = ui("Frame", {
            AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,2,0.5,0),
            Size = UDim2.fromOffset(11,11), BackgroundColor3 = Color3.fromRGB(180,180,185),
            BorderSizePixel = 0, ZIndex = 5,
        }, ind)
        rounded(knob, 6)
        local function update()
            local on = el.Value
            TweenService:Create(knob, TweenInfo.new(.15), {
                Position = UDim2.new(0, on and 15 or 2, 0.5, 0),
                BackgroundColor3 = on and Color3.new(1,1,1) or Color3.fromRGB(180,180,185),
            }):Play()
            TweenService:Create(ind, TweenInfo.new(.15), {
                BackgroundColor3 = on and Color3.fromRGB(80,80,90) or Color3.fromRGB(40,40,45),
            }):Play()
        end
        el._update = update
        update()
        row.MouseButton1Click:Connect(function()
            el.Value = not el.Value
            update()
            el:_fire()
        end)
    end
    table.insert(self.Elements, el)
    return el
end

